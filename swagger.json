{
  "openapi": "3.0.3",
  "info": {
    "title": "Task API",
    "version": "1.0.0",
    "description": "API za upravljanje knjigama i autentifikaciju preko Supabase-a"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Lokalni razvojni server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Unesi svoj pristupni token (bez riječi 'Bearer' ispred)"
      }
    },
    "schemas": {
      "Book": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "1984" },
          "author": { "type": "string", "example": "George Orwell" },
          "year_published": { "type": "integer", "example": 1949 },
          "available": { "type": "boolean", "example": false }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "dca738d2-9721-4d37-8851-93bf28328da3"
          },
          "email": { "type": "string", "example": "user@example.com" }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Health Check / Info",
        "responses": {
          "200": {
            "description": "Uspješno dobijeni bazični info o aplikaciji"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Provjera statusa aplikacije",
        "responses": {
          "200": {
            "description": "Aplikacija radi stabilno"
          }
        }
      }
    },
    "/books": {
      "get": {
        "summary": "Preuzmi sve knjige",
        "responses": {
          "200": {
            "description": "Lista svih knjiga",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Book" }
                }
              }
            }
          },
          "429": { "description": "Rate limit prekoračen - Hold on bot!" },
          "500": { "description": "Interna greška servera" }
        }
      },
      "post": {
        "summary": "Kreiraj novu knjigu",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "author"],
                "properties": {
                  "title": { "type": "string", "example": "The Hobbit" },
                  "author": { "type": "string", "example": "J.R.R. Tolkien" },
                  "year_published": { "type": "integer", "example": 1937 },
                  "available": { "type": "boolean", "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Knjiga uspješno kreirana",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Book" }
              }
            }
          },
          "400": { "description": "Naslov i autor su obavezna polja" },
          "500": { "description": "Interna greška servera" }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "Preuzmi pojedinačnu knjigu po ID-ju",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Knjiga pronađena",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Book" }
              }
            }
          },
          "404": { "description": "Knjiga sa tim ID-jem nije pronađena" },
          "500": { "description": "Interna greška servera" }
        }
      },
      "put": {
        "summary": "Ažuriraj knjigu po ID-ju",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "author": { "type": "string" },
                  "year_published": { "type": "integer" },
                  "available": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Knjiga uspješno ažurirana",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Book" }
              }
            }
          },
          "400": {
            "description": "Naslov ili autor ne mogu biti prazni stringovi"
          },
          "404": { "description": "Knjiga nije pronađena" },
          "500": { "description": "Interna greška servera" }
        }
      },
      "delete": {
        "summary": "Obriši knjigu po ID-ju",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "204": { "description": "Uspješno obrisano, nema sadržaja" },
          "404": { "description": "Knjiga sa tim ID-jem ne postoji" },
          "500": { "description": "Interna greška servera" }
        }
      }
    },
    "/books/{id}/toggle-availability": {
      "patch": {
        "summary": "Promijeni status dostupnosti knjige (True/False)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Status uspješno prebačen",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Book" }
              }
            }
          },
          "404": { "description": "Knjiga nije pronađena" },
          "500": { "description": "Interna greška servera" }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Registracija novog korisnika preko Supabase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "user@example.com" },
                  "password": {
                    "type": "string",
                    "example": "securepassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Korisnik uspješno kreiran",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "description": "Greška u zahtjevu ili podaci već postoje" },
          "500": { "description": "Interna greška servera" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Prijava korisnika (Vraća JWT Token)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "user@example.com" },
                  "password": {
                    "type": "string",
                    "example": "securepassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uspješna prijava, vraćen token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" },
                    "access_token": {
                      "type": "string",
                      "example": "eyJhbGciOi..."
                    },
                    "refresh_token": {
                      "type": "string",
                      "example": "eyJhbGciOi..."
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Pogrešan email ili lozinka" },
          "500": { "description": "Interna greška servera" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Odjava korisnika i uništavanje sesije",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "204": { "description": "Uspješno odjavljen" },
          "401": { "description": "Neautorizovan ili nevalidan token" },
          "500": { "description": "Interna greška servera" }
        }
      }
    },
    "/public/info": {
      "get": {
        "summary": "Javne informacije dostupne svima",
        "responses": {
          "200": {
            "description": "Poruka dobrodošlice klijentu"
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Profil trenutno prijavljenog korisnika",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Vraća objekat korisnika",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "description": "Token nedostaje ili je nevalidan" }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Zaštićeni dashboard panel",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Poruka dobrodošlice sa emailom korisnika"
          },
          "401": { "description": "Token nedostaje ili je nevalidan" }
        }
      }
    }
  }
}
